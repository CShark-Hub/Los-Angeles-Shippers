---
source: crates/mercury-schema/tests/config_examples.rs
expression: models
---
{
  "backends": {
    "openrouter": {
      "chat_url": "https://openrouter.ai/api/v1/chat/completions",
      "decisions_url": "https://openrouter.ai/api/alpha/decisions",
      "key_file": "/run/secrets/openrouter_api_key",
      "provider": {
        "data_collection": "deny",
        "zdr": true
      }
    },
    "openai_compatible": {
      "chat_url": "http://llm:8000/v1/chat/completions",
      "key_file": null
    }
  },
  "roles": {
    "judge": {
      "backend": "openrouter",
      "kind": "jev",
      "model": "typesafe/jev-1.13",
      "timeout_ms": 2000
    },
    "judge_fallback": {
      "backend": "openrouter",
      "kind": "chat",
      "model": "openai/gpt-4.1-mini-2025-04-14",
      "timeout_ms": 4000,
      "temperature": 0.0,
      "max_tokens": 300
    },
    "planner": {
      "backend": "openrouter",
      "model": "openai/gpt-4.1-mini-2025-04-14",
      "temperature": 0.0,
      "max_tokens": 150
    },
    "composer": {
      "backend": "openrouter",
      "model": "anthropic/claude-4.6-sonnet-20260217",
      "temperature": 0.2,
      "max_tokens": 400
    }
  },
  "budgets": {
    "per_question_usd": 0.15,
    "per_user_daily_usd": 1.0,
    "global_daily_usd": 2.0
  }
}
