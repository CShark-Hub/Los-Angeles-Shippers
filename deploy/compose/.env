COMPOSE_FILE=docker-compose.yml:docker-compose.repos.yml
COMPOSE_PATH_SEPARATOR=:   # the same list on Windows, whose default separator is ;
MERCURY_DOMAIN=mercury.example.com
MERCURY_VERSION=0.0.0
MERCURY_REGISTRY=mercury   # a local name until the images are published; they are built on the machine

# laptops only (docker-compose.local.yml): the origin the browser uses, if not http://localhost:8080
# MERCURY_PUBLIC_ORIGIN=https://<laptop>.<tailnet>.ts.net
